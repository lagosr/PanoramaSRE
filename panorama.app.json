{
  "$schema": "https://wsh.panoramadr.com/res/schemas/panorama.app.schema.json",
  "schemaVersion": 1,
  "appId": "sre",
  "slug": "sre",
  "displayName": "PanoramaSRE",
  "portalTitle": "Panorama SRE",
  "description": "Windows SRE Control Plane, Live System Tray Monitor, Git Release Provenance Tracker, and Local Dev Orchestrator",
  "basePath": "/sre",
  "port": 3050,
  "containerName": "panorama-sre",
  "composeProject": "panorama-sre",
  "remoteAppRoot": "/opt/panorama-sre",
  "dataVolume": "/var/data/panorama-sre/data",
  "localSqlitePath": "data/sre.sqlite",
  "themeColor": "emerald",
  "icon": "Gauge",
  "portalOrder": 5,
  "roles": ["admin"],
  "sre": {
    "deployScript": "",
    "dbScript": "",
    "devCommand": "npm run tauri dev",
    "healthEndpoint": "/sre/api/health",
    "manifestEndpoint": "",
    "testCommand": "npm test",
    "typecheckCommand": "npx tsc --noEmit",
    "requiresAuthInDev": false,
    "automatedBackupDefault": false,
    "exposeInRemotePortal": false
  }
}
